<<<import>>>
import { CloudApiTransport } from '@wappa/cloud-api';
<<<setup>>>
/** Read a required environment variable, failing fast with a helpful message. */
function requireEnv(name: string): string {
  const value = process.env[name];
  if (!value) throw new Error(`Missing environment variable ${name} — see .env.example`);
  return value;
}

// Official WhatsApp Cloud API — the transport runs a webhook server on PORT.
// Point the Meta app dashboard at it (callback URL + verify token); README.md
// walks through the setup.
const transport = new CloudApiTransport({
  accessToken: requireEnv('WHATSAPP_ACCESS_TOKEN'),
  phoneNumberId: requireEnv('WHATSAPP_PHONE_NUMBER_ID'),
  verifyToken: requireEnv('WHATSAPP_VERIFY_TOKEN'),
  appSecret: process.env.WHATSAPP_APP_SECRET,
  port: Number(process.env.PORT ?? 3000),
});
