# --- Meta App Dashboard -> WhatsApp -> API Setup ---
# Access token (temporary token for dev; a System User token for production).
WHATSAPP_ACCESS_TOKEN=EAAG...
# The "Phone number ID" shown next to the sending number (not the number itself).
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Any string you invent. Enter the SAME value as "Verify token" when configuring
# the webhook (WhatsApp -> Configuration); Meta echoes it back on verification.
WHATSAPP_VERIFY_TOKEN=change-me

# App settings -> Basic -> App secret. Enables X-Hub-Signature-256 validation of
# webhook deliveries. Optional but strongly recommended.
WHATSAPP_APP_SECRET=

# OpenAI API key — picked up from the environment by the OpenAI SDK.
OPENAI_API_KEY=sk-...

# Port for the webhook HTTP server (your public HTTPS tunnel should forward here).
PORT=3000
