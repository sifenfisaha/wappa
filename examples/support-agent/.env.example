# Anthropic API key — picked up from the environment by the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp JID of the human operator who receives escalation notifications and
# sends '/resume <chatId>'. A DM JID: <phone number>@s.whatsapp.net.
# Optional — but without it, escalations pause the chat with nobody notified,
# and the operator-only /resume command is DISABLED (it fails closed: with no
# configured operator, nobody may unpause handed-off chats).
OPERATOR_CHAT_ID=15551234567@s.whatsapp.net
